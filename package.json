{
  "name": "mas-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "cli": "node --use-env-proxy apps/cli/dist/index.js",
    "smoke:api": "pnpm run build && node --use-env-proxy apps/cli/dist/api-smoke.js",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
