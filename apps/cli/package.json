{
  "name": "@mas-chat/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mas-chat": "./dist/index.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke:api": "node --use-env-proxy dist/api-smoke.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mas-chat/protocol": "workspace:*",
    "@mas-chat/runtime": "workspace:*",
    "@mas-chat/storage": "workspace:*",
    "openai": "^7.20.0"
  }
}
