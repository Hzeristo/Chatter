# MAS Chat loads .env from the current working directory.
# Precedence is intentionally: .env > process/system environment > defaults.

# Required for API commands. Compatible gateways may accept a provider-specific
# token or a non-secret placeholder, but MAS Chat always sends it as Bearer auth.
OPENAI_API_KEY=

# Full OpenAI-compatible API root. It must implement the Responses endpoints
# used for create, background streaming, retrieve/starting_after, and cancel.
OPENAI_BASE_URL=https://api.openai.com/v1

# Runtime request settings.
MAS_CHAT_MODEL=gpt-6-astra
MAS_CHAT_REASONING_EFFORT=max
MAS_CHAT_REASONING_SUMMARY=auto
MAS_CHAT_TEXT_VERBOSITY=medium
MAS_CHAT_WEB_SEARCH=true
MAS_CHAT_CODE_INTERPRETER=false

# Retry once in foreground only when the endpoint explicitly rejects the
# background parameter. Use never to require resumable background execution.
MAS_CHAT_BACKGROUND_FALLBACK=on_unsupported

# Local state and visible developer instructions.
MAS_CHAT_DATA_DIR=.chat-runtime
MAS_CHAT_DEVELOPER_PROMPT="Help the user complete the requested task. Keep progress updates concise and provide a clear final answer."
